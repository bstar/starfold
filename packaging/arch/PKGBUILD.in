# Generated by scripts/dist/arch.sh for the exact checkout being built.
pkgname=starfold
pkgver=@VERSION@
pkgrel=1
pkgdesc='A stack-based terminal file manager in the STAR family'
arch=('x86_64')
url='https://github.com/bstar/starfold'
license=('MIT' 'LicenseRef-UnRAR')
depends=('glibc' 'gcc-libs' 'ffmpeg' 'alsa-lib')
makedepends=('rust>=1.92' 'git' 'clang' 'pkgconf')
optdepends=('xdg-utils: open files with desktop applications'
            'libvips: thumbnail very large images'
            'neovim: optional embedded text editor')
options=('!lto' '!debug')
source=("starfold-${pkgver}.tar.gz" "staramp-source::git+https://github.com/bstar/staramp.git#commit=@AMP_REV@")
sha256sums=('@SHA256@' 'SKIP')

_cargo_env() {
    export CARGO_HOME="${ARCH_CARGO_HOME:-$srcdir/cargo}"
    export CARGO_TARGET_DIR="$srcdir/target"
    export CARGO_NET_GIT_FETCH_WITH_CLI=true
}

prepare() {
    cd "$srcdir/starfold-$pkgver"
    _cargo_env
    cargo fetch --locked
    CARGO_TARGET_DIR="$srcdir/target-amp" cargo fetch --manifest-path "$srcdir/staramp-source/Cargo.toml" --locked
}

build() {
    cd "$srcdir/starfold-$pkgver"
    _cargo_env
    CARGO_TARGET_DIR="$srcdir/target-amp" cargo build --manifest-path "$srcdir/staramp-source/Cargo.toml" --release --frozen
    cargo build --workspace --release --frozen
}

check() {
    cd "$srcdir/starfold-$pkgver"
    _cargo_env
    cargo test --workspace --release --frozen --all
}

package() {
    cd "$srcdir/starfold-$pkgver"
    install -Dm755 "$srcdir/target/release/starfold" "$pkgdir/usr/bin/starfold"
    install -Dm755 "$srcdir/target-amp/release/staramp" "$pkgdir/usr/bin/starfold-staramp"
    for helper in starfold-preview-pdf starfold-preview-video starfold-preview-nvim; do
        install -Dm755 "$srcdir/target/release/$helper" "$pkgdir/usr/bin/$helper"
    done
    install -Dm644 packaging/starfold.desktop "$pkgdir/usr/share/applications/starfold.desktop"
    install -Dm644 packaging/starfold.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/starfold.png"
    install -Dm644 packaging/starfold.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/starfold.svg"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/starfold/LICENSE"
    install -Dm644 LICENSES/UnRAR.txt "$pkgdir/usr/share/licenses/starfold/UnRAR.txt"
    install -Dm644 NOTICE "$pkgdir/usr/share/doc/starfold/NOTICE"
    for media_license in LICENSES/ffmpeg-*.txt LICENSES/Hayro-*.txt; do
        install -Dm644 "$media_license" "$pkgdir/usr/share/licenses/starfold/$(basename "$media_license")"
    done
    install -Dm644 LICENSES/OFL-Liberation.txt "$pkgdir/usr/share/licenses/starfold/OFL-Liberation.txt"
    install -Dm644 README.md "$pkgdir/usr/share/doc/starfold/README.md"
    cp -R documentation "$pkgdir/usr/share/doc/starfold/"
    mkdir -p "$pkgdir/usr/share/licenses/starfold/STARAMP"
    cp "$srcdir/staramp-source/LICENSE" "$pkgdir/usr/share/licenses/starfold/STARAMP/"
    cp -R "$srcdir/staramp-source/LICENSES/". "$pkgdir/usr/share/licenses/starfold/STARAMP/"
}
