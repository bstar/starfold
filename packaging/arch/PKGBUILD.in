# Generated by scripts/dist/arch.sh for the exact checkout being built.
pkgname=starfold
pkgver=@VERSION@
pkgrel=1
pkgdesc='A stack-based terminal file manager in the STAR family'
arch=('x86_64')
url='https://github.com/bstar/starfold'
license=('MIT' 'LicenseRef-UnRAR')
depends=('glibc' 'gcc-libs')
makedepends=('rust>=1.90' 'git')
optdepends=('xdg-utils: open files with desktop applications'
            'libvips: thumbnail very large images')
options=('!lto' '!debug')
source=("starfold-${pkgver}.tar.gz")
sha256sums=('@SHA256@')

_cargo_env() {
    export CARGO_HOME="${ARCH_CARGO_HOME:-$srcdir/cargo}"
    export CARGO_TARGET_DIR="$srcdir/target"
    export CARGO_NET_GIT_FETCH_WITH_CLI=true
}

prepare() {
    cd "$srcdir/starfold-$pkgver"
    _cargo_env
    cargo fetch --locked
}

build() {
    cd "$srcdir/starfold-$pkgver"
    _cargo_env
    cargo build --release --frozen
}

check() {
    cd "$srcdir/starfold-$pkgver"
    _cargo_env
    cargo test --release --frozen --all
}

package() {
    cd "$srcdir/starfold-$pkgver"
    install -Dm755 "$srcdir/target/release/starfold" "$pkgdir/usr/bin/starfold"
    install -Dm644 packaging/starfold.desktop "$pkgdir/usr/share/applications/starfold.desktop"
    install -Dm644 packaging/starfold.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/starfold.png"
    install -Dm644 packaging/starfold.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/starfold.svg"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/starfold/LICENSE"
    install -Dm644 LICENSES/UnRAR.txt "$pkgdir/usr/share/licenses/starfold/UnRAR.txt"
    install -Dm644 LICENSES/OFL-Liberation.txt "$pkgdir/usr/share/licenses/starfold/OFL-Liberation.txt"
    install -Dm644 README.md "$pkgdir/usr/share/doc/starfold/README.md"
}
